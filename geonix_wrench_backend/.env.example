# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# Only the values above the first divider have no safe default — the server
# either refuses to start or quietly misbehaves without them.

# ── Required ──────────────────────────────────────────────────────────────────

# Where the app is allowed to be called from. Leave UNSET only in local
# development: with no value the API accepts any origin (without credentials)
# and warns loudly at every boot.
ALLOWED_ORIGINS=https://geonixsoftware.github.io

# Stripe. Use sk_test_ / a test webhook secret until you have completed a real
# end-to-end purchase, then switch both to live at the same time.
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Which engine turns a transcript into job card fields:
#   anthropic  a hosted model. Needs ANTHROPIC_API_KEY. Nothing to self-host.
#   ollama     a model you run yourself. No transcript leaves your server.
#   stub       keyword matching, no AI at all. Development only — the server
#              warns on every boot, because the job cards are guesses.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-replace-me

# ── Paths (set these when running in a container) ─────────────────────────────

# Both must live on a persistent volume or you lose every job card and logo on
# the next restart.
DB_PATH=/data/geonix_wrench.db
LOGO_STORAGE_DIR=/data/logos
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# ── Transcription ─────────────────────────────────────────────────────────────

# tiny | base | small | medium | large-v3. Bigger is more accurate and slower,
# and holds more RAM. "small" is the default and a reasonable balance on CPU.
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
# Leave unset to auto-detect the spoken language; set e.g. "en" or "cs" to pin
# it, which is both faster and more accurate when you know it in advance.
# WHISPER_LANGUAGE=
# Concurrency is bounded because each worker holds its own copy of the model in
# memory. Raise only if you have the RAM to spare.
WHISPER_MAX_CONCURRENT=1
WHISPER_MAX_QUEUED=8

# ── Ollama (only when LLM_PROVIDER=ollama) ────────────────────────────────────

# From inside a container, "localhost" is the container. Use the host gateway.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b

# ── Pricing — must match what the website and app advertise ───────────────────

# Verify with: python -m price_check
INDIVIDUAL_PRICE_ID=price_replace_me
TEAM_PRICE_ID=price_replace_me
INDIVIDUAL_PRICE_PER_MONTH=29
TEAM_PRICE_PER_SEAT=25
TEAM_MIN_SEATS=2
BILLING_CURRENCY=EUR

# ── Optional ──────────────────────────────────────────────────────────────────

# Publishes the entire route map and schemas at /docs. Keep off in production.
ENABLE_API_DOCS=false
DEFAULT_LABOR_RATE=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_PER_WINDOW=120
RATE_LIMIT_AUDIO_PER_WINDOW=10
