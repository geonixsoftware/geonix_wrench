# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# Only the values above the first divider have no safe default — the server
# either refuses to start or quietly misbehaves without them.

# ── Required ──────────────────────────────────────────────────────────────────

# Where the app is allowed to be called from. The website is served from
# geonix.site and the API answers on api.geonix.site — different origins, so
# the site has to be named here or the browser blocks every call. main.py falls
# back to these same three when this is unset.
ALLOWED_ORIGINS=https://geonix.site,https://api.geonix.site,http://localhost:3000

# Optional. Leave EMPTY when nginx is in front: it serves geonix_website/dist
# itself and proxies only /api/ here. Set it to the built site's path to run
# without nginx, and uvicorn will serve the website and the API on one port.
#FRONTEND_DIST_DIR=/var/www/geonix_wrench/geonix_website/dist

# Stripe. Use sk_test_ / a test webhook secret until you have completed a real
# end-to-end purchase, then switch both to live at the same time.
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Which engine turns a transcript into job card fields:
#   anthropic  a hosted model. Needs ANTHROPIC_API_KEY. Nothing to self-host.
#   ollama     a model you run yourself. No transcript leaves your server.
#   stub       keyword matching, no AI at all. Development only — the server
#              warns on every boot, because the job cards are guesses.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-replace-me
# ANTHROPIC_MODEL=claude-opus-5
# How long one extraction may take, and how many times it may be retried.
# Bounded on purpose: the SDK's own defaults are 10 minutes and 2 retries, and
# it retries timeouts — so an unresponsive provider could hold a worker for
# half an hour on a job card whose app gave up after 180 seconds. Keep
# timeout x (retries + 1) comfortably under that 180s client budget.
# ANTHROPIC_TIMEOUT_SECONDS=45
# ANTHROPIC_MAX_RETRIES=1

# ── Paths (set these when running in a container) ─────────────────────────────

# Both must live on a persistent volume or you lose every job card and logo on
# the next restart.
DB_PATH=/data/geonix_wrench.db
LOGO_STORAGE_DIR=/data/logos
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# ── Transcription ─────────────────────────────────────────────────────────────

# tiny | base | small | medium | large-v3. Bigger is more accurate and slower,
# and holds more RAM. "small" is the default and a reasonable balance on CPU.
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
# Leave unset to auto-detect the spoken language; set e.g. "en" or "cs" to pin
# it, which is both faster and more accurate when you know it in advance.
# WHISPER_LANGUAGE=
# Concurrency is bounded because each worker holds its own copy of the model in
# memory. Raise only if you have the RAM to spare.
#
# It also costs single-request speed, which is the case that matters most: the
# cores are split evenly between the slots (WHISPER_CPU_THREADS), so 4 slots on
# a 4-core box give one core each — and a mechanic recording alone, the normal
# case, transcribes on one core while three sit idle. Leave this unset to let
# the server size it from the machine (1 slot at 4 cores or fewer), and let
# WHISPER_MAX_QUEUED absorb bursts instead.
# WHISPER_MAX_CONCURRENT=1
WHISPER_MAX_QUEUED=8

# ── Ollama (only when LLM_PROVIDER=ollama) ────────────────────────────────────

# From inside a container, "localhost" is the container. Use the host gateway.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b
# Ollama drops the model from memory after 5 idle minutes by default, so the
# first job card after a quiet spell pays a full model load. "-1" pins it.
# OLLAMA_KEEP_ALIVE=30m

# ── Pricing — must match what the website and app advertise ───────────────────

# Verify with: python -m price_check
INDIVIDUAL_PRICE_ID=price_replace_me
TEAM_PRICE_ID=price_replace_me
INDIVIDUAL_PRICE_PER_MONTH=29
TEAM_PRICE_PER_SEAT=25
TEAM_MIN_SEATS=2
BILLING_CURRENCY=EUR

# ── Email ─────────────────────────────────────────────────────────────────────

# Sends the "your subscription is active" email on a new subscription. Leave
# SMTP_HOST unset to turn email off entirely (the default) — nothing here is
# required for the rest of the app to work, and every send becomes a no-op
# that only logs. Works with any relay: SendGrid, Mailgun, Postmark, Gmail, or
# a local catcher like MailHog for development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM_ADDRESS=billing@geonix.site
# EMAIL_FROM_NAME=Geonix Wrench

# ── Admin dashboard ────────────────────────────────────────────────────────────

# Subtracted from estimated revenue to show "profit" on the master admin
# dashboard. Nothing here tracks Stripe fees, server costs or payroll, so this
# is a placeholder (0 = profit shown equal to revenue) until set to your
# actual recurring costs.
# ADMIN_MONTHLY_COSTS=0

# ── Optional ──────────────────────────────────────────────────────────────────

# Publishes the entire route map and schemas at /docs. Keep off in production.
ENABLE_API_DOCS=false
DEFAULT_LABOR_RATE=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_PER_WINDOW=120
RATE_LIMIT_AUDIO_PER_WINDOW=10

# ── Device limits ─────────────────────────────────────────────────────────────

# How many devices one account may be signed in on at once. The quota follows
# the role, not the plan: an employee is issued one device by the shop, while an
# Individual subscriber and a shop owner are each one person with a phone, a
# tablet and a workshop machine.
DEVICE_LIMIT_INDIVIDUAL=3
DEVICE_LIMIT_TEAM_OWNER=3
DEVICE_LIMIT_TEAM_MEMBER=1

# What a sign-in past the ceiling does.
#   evict_oldest  the least recently used device is signed out (default)
#   reject        the new sign-in is refused with 403
DEVICE_LIMIT_POLICY=evict_oldest

# Refuse any request that arrives without an X-Device-Id header. Leave false
# until every shipped build of the app sends one — older builds go uncounted
# rather than broken. Once true, dropping the header stops being a way around
# the quota.
REQUIRE_DEVICE_ID=false

# How long a signed-out device is remembered, so it learns it was signed out
# instead of silently re-registering itself. 30 days.
DEVICE_SESSION_RETENTION_HOURS=720
