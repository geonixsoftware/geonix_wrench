<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Required by Firebase Auth: it stores the session in Apple's
	     data-protection keychain (kSecUseDataProtectionKeychain = true), which
	     only grants an access group to a signature backed by a provisioning
	     profile. Declaring this key is what makes Xcode fetch and embed that
	     profile. Keep the $(AppIdentifierPrefix) macro — Xcode expands it to the
	     team ID at build time; a hardcoded value or a raw `codesign` invocation
	     produces an unauthorized entitlement and the app is SIGKILLed at launch. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.geonixsoftware.wrench</string>
	</array>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
