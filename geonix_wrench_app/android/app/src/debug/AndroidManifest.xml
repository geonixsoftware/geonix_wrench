<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only. src/main keeps cleartext locked off app-wide, and
         this source set is never part of a release APK, so the shipped app is
         unchanged.

         Needed because a phone cannot reach a backend on your laptop over
         loopback — the dev server lives at a LAN address, and talking to it
         means plain HTTP. The paired res/xml/network_security_config.xml
         narrows that to private address ranges rather than opening cleartext
         to the whole internet.

         usesCleartextTraffic is overridden as well as the config: from API 24
         the network security config wins, but on API 23 and below this
         attribute is still what decides. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
